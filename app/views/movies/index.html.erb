<p style="color: green"><%= notice %></p>

<style>

  h1 {
    margin-top: 0;
    margin-bottom: 0;
  }

  h2 {
    margin-top: 0;
  }

  table, th, td {
    border: 1px solid black;
  }

  th, td {
    padding: 8px;
    text-align: left;
  }

  th.sorted-asc {
  background-color: green;
}

th.sorted-desc {
  background-color: red;
}
</style>

<% content_for :title, "Movies" %>

<h1 style="text-align: center; background-color: red; color: white; padding: 30px;">
  🥔 RottenPotatoes
</h1>

<h2 style="text-align: center; background-color: red; color: white; padding: 30px;">
   Movies
</h2>

<% sorted_by = params[:sort].presence || "title" %>
<% sort_direction = params[:direction].presence || "asc" %>

<table style="border-collapse: collapse; width: 100%;">
  <thead>
    <tr>
      <th class="<%= 'sorted-' + params[:direction] if params[:sort] == 'title' %>">
        Title
        <% if params[:sort] == 'title' %>
          <%= params[:direction] == 'asc' ? '▲' : '▼' %>
      <% end %>
      </th>
      <th class="<%= 'sorted-' + params[:direction] if params[:sort] == 'release_date' %>">
        Release Date
        <% if params[:sort] == 'release_date' %>
          <%= params[:direction] == 'asc' ? '▲' : '▼' %>
      <% end %>
      </th>
      <th class="<%= 'sorted-' + params[:direction] if params[:sort] == 'rating' %>">
        Rating
        <% if params[:sort] == 'rating' %>
          <%= params[:direction] == 'asc' ? '▲' : '▼' %>
      <% end %>
      </th>
      <th>Link</th>
    </tr>
  </thead>

  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= movie.title %></td>
        <td><%= movie.release_date %></td>
        <td><%= movie.rating %></td>
        <td><%= link_to "Show this movie", movie %></td>
      </tr>
    <% end %>
  </tbody>

  <tfoot>
    <tr>
      <td colspan="4">Total movies: <%= @movies.size %></td>
    </tr>
  </tfoot>
</table>

<%= link_to "New movie", new_movie_path(sort: params[:sort], direction: params[:direction]) %>

<div>
  <%= link_to "Sort by Title in Ascending order", movies_path(sort: "title", direction: "asc") %>
</div>

<div>
  <%= link_to "Sort by Title in Descending order", movies_path(sort: "title", direction: "desc") %>
</div>

<div>
  <%= link_to "Sort by Release Date in Ascending order", movies_path(sort: "release_date", direction: "asc") %>
</div>

<div>
  <%= link_to "Sort by Release Date in Descending order", movies_path(sort: "release_date", direction: "desc") %>
</div>

<div>
  <%= link_to "Sort by Rating in Ascending order", movies_path(sort: "rating", direction: "asc") %>
</div>

<div>
  <%= link_to "Sort by Rating in Descending order", movies_path(sort: "rating", direction: "desc") %>
</div>




