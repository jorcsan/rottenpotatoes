<% content_for :title, @movie.title %>

<style>
  .movie-container {
    max-width: 600px;
    width: 90%;
    margin: 30px auto;
    padding: 30px;
    background-color: #f5f5f5;
    border: 1px solid #ccc;
    border-radius: 10px;
    box-sizing: border-box;
  }

  .movie-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 25px;
  }

  .movie-actions a,
  .movie-actions input[type="submit"] {
    display: block;
    width: 100%;
    padding: 12px;
    box-sizing: border-box;
    text-align: center;
    text-decoration: none;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 16px;
  }

  .movie-actions a {
    background-color: red;
    color: white;
  }

  .movie-actions input[type="submit"] {
    background-color: #333;
    color: white;
  }

  .movie-actions a:hover {
    background-color: darkred;
  }

  .movie-actions input[type="submit"]:hover {
    background-color: #555;
  }

  .notice {
    color: green;
    text-align: center;
    margin-bottom: 15px;
  }
</style>

<h1 style="text-align: center; background-color: red; color: white; padding: 30px; margin: 0;">
  🥔 RottenPotatoes
</h1>

<h2 style="text-align: center; background-color: white; color: black; padding: 30px; margin: 0;">
  Movie Details
</h2>

<div class="movie-container">
  <p class="notice"><%= notice %></p>

  <%= render @movie %>

  <div class="movie-actions">
    <%= link_to "Edit this movie",
        edit_movie_path(
          @movie,
          sort: params[:sort],
          direction: params[:direction]
        ) %>

    <%= link_to "Back to movies",
        movies_path(
          sort: params[:sort],
          direction: params[:direction]
        ) %>

    <%= button_to "Destroy this movie",
        @movie,
        method: :delete,
        params: {
          sort: params[:sort],
          direction: params[:direction]
        } %>
  </div>
</div>